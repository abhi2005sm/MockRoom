# MockRoom Environment Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mockroom?schema=public

# Redis & BullMQ
REDIS_URL=redis://localhost:6379

# JWT Auth
JWT_SECRET=mockroom_super_secret_jwt_key_2026
JWT_EXPIRATION=7d

# S3 / MinIO Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=mockroom-storage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Provider API Keys
STT_API_KEY=mock_deepgram_key
LLM_API_KEY=mock_anthropic_key
TTS_API_KEY=mock_elevenlabs_key

# Code Execution Sandbox (Judge0 / Piston)
SANDBOX_URL=http://localhost:2358

# App Settings
ALLOWED_ORIGINS=http://localhost:3000
MAX_SESSION_MINUTES=60
TIP_REFRESH_CRON="0 0 * * *"
